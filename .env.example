# Enquiry form delivery — configure ONE of the following options:

# Option 1: Webhook (Zapier, Make, custom CRM endpoint)
ENQUIRY_WEBHOOK_URL=https://your-webhook-endpoint.com/enquiry

# Option 2: Resend email delivery
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=Learnicate <enquiries@yourdomain.com>
ENQUIRY_NOTIFY_EMAIL=Learnicate24@gmail.com

# In development without configuration, enquiries are logged to the server console.
# In production, the API returns a 503 error until delivery is configured.
